{
  "model": {
    "name": "mobilenet_v3_small",
    "num_classes": 5
  },
  "optimization": {
    "random_seed": 42,
    "initial" : {
      "max_epochs": 100,
      "batch_size": 256,
      "learning_rate": 0.001,
      "patience": 10
    },
    "deep_clustering" : {
      "clustering_algorithm": "Kmeans",
